# =============================================================
# Database Configuration
# -------------------------------------------------------------
# These individual variables are used by the pg Pool
# (src/config/index.ts, scripts/*, src/services/workflow.service.ts ...)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geobpm
DB_USER=postgres
DB_PASSWORD=your_password

# DATABASE_URL is required by Prisma (prisma/schema.prisma).
# Keep it in sync with the DB_* variables above.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/geobpm

# =============================================================
# JWT Configuration
# -------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key
# Secret used to sign/verify refresh tokens (login + /refresh endpoint).
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=1h

# =============================================================
# Server Configuration
# -------------------------------------------------------------
PORT=3000
NODE_ENV=development

# =============================================================
# Extraction Configuration
# -------------------------------------------------------------
EXTRACTION_CONFIDENCE_THRESHOLD=90
EXTRACTION_FORMATS=png,jpeg,pdf
COORD_FORMAT=decimal
# Set to "true" to bypass the real Flask API during local development.
USE_MOCK_FLASK=false

# =============================================================
# Google Cloud Configuration
# -------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json
GEMINI_API_KEY=your-gemini-api-key

# =============================================================
# Flask API Configuration
# -------------------------------------------------------------
FLASK_API_URL=http://localhost:5000/flask/extraction
